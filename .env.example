# Contact email for "polite pool" APIs (OpenAlex). Optional but recommended.
CONTACT_EMAIL=

# Google Books API key (optional; raises quota). https://developers.google.com/books
GOOGLE_BOOKS_API_KEY=

# Semantic Scholar API key (optional; raises rate limit). https://www.semanticscholar.org/product/api
S2_API_KEY=

# SQLite database path. Defaults to ~/.your-library/library.db
YOUR_LIBRARY_DB=

# Optional tuning (milliseconds / counts)
YOUR_LIBRARY_HTTP_TIMEOUT_MS=
YOUR_LIBRARY_HTTP_RETRIES=
YOUR_LIBRARY_DEFAULT_LIMIT=
YOUR_LIBRARY_MAX_LIMIT=
